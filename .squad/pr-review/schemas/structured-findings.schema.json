{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Review structured findings",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "severity", "category", "file", "message"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "severity": { "type": "string", "enum": ["blocker", "major", "minor", "nit"] },
      "category": {
        "type": "string",
        "enum": ["correctness", "code_quality", "testing", "perf", "security", "api", "parity", "design_alignment", "agentic", "style", "other"]
      },
      "file": { "type": "string", "minLength": 1 },
      "line_start": { "type": ["integer", "string"] },
      "line_end": { "type": ["integer", "string"] },
      "message": { "type": "string", "minLength": 1, "maxLength": 400 },
      "evidence": { "type": "string" },
      "suggested_fix": { "type": "string" },
      "verified_by_grep": { "type": "string" },
      "design_doc_citation": { "type": "string" },
      "tags": {
        "type": ["array", "string"],
        "items": { "type": "string" }
      }
    }
  }
}
