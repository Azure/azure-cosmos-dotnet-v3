<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Microsoft.Azure.Cosmos.Direct</AssemblyName>
    <RootNamespace>Microsoft.Azure.Documents</RootNamespace>
    <Version>$(DirectVersion)</Version>
    <AssemblyVersion>$(DirectVersion).0</AssemblyVersion>
    <FileVersion>$(DirectVersion)</FileVersion>
    <InformationalVersion>$(DirectVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Microsoft Corporation</Company>
    <Product>Microsoft(R) Azure Cosmos</Product>
    <Copyright>Copyright (c) Microsoft Corporation. All rights reserved.</Copyright>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Preserve the upstream Snapshot and DocumentCollection sources without rewriting their warning baselines. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0108;CS0472</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <IsRidAgnostic>false</IsRidAgnostic>
    <ShippingScope>External</ShippingScope>
    <SigningType>Product</SigningType>
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>..\..\..\35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>TRACE;NETSTANDARD20;DOCDBCLIENT;COSMOSCLIENT;CODE_ANALYSIS;NETSTANDARD2_0;DelaySignKeys;AssemblyInfo_PublicKeyRefOnly</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\RMResources.resx" LogicalName="Microsoft.Azure.Documents.RMResources.resources" />
    <PackageReference Include="Newtonsoft.Json" Version="10.0.2" NoWarn="NU1903" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="6.0.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <Import Project="..\QueryPlanInterop.props" />
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <None Include="$(QueryPlanInteropNativePath)"
          Link="Microsoft.Azure.Cosmos.ServiceInterop.dll"
          TargetPath="Microsoft.Azure.Cosmos.ServiceInterop.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- This type was generated by the upstream version build and is part of the internal binary contract. -->
  <Target Name="GenerateDirectAssemblyVersionInfo" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)DirectAssemblyVersionInfo.g.cs"
                      Lines="internal static class AssemblyVersionInfo { public const string AssemblyFileVersionString = &quot;$(DirectVersion)&quot;%3B }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DirectAssemblyVersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="RejectInternalDirectBuild" BeforeTargets="PrepareForBuild" Condition="'$(ProjectRef)' == 'True'">
    <Error Text="OSS builds must use the original CosmosDB Direct project, not the mirrored public project." />
  </Target>
</Project>
