      "forbidden": ["Empty/shrunken/ambiguous cohorts or collapsed labels masquerading as exact rows."],
      "interactions": ["Independent semantic adequacy is still pending."],
      "scenarios": [{ "id": "M01/scenario/mapping", "kind": "negative", "expectation": "Broken links, duplicate typed tuples and stale/incomplete sets fail." }],
      "authority": { "status": "unresolved", "reference": null }
    },
    {
      "id": "M01/terminal", "version": "0.1", "lifecycle": "unresolved",
      "preconditions": ["A synthetic supported-shape TRX and separately declared expected set are supplied."],
      "allowed": ["One passing terminal execution per required case; preserve parent/raw counters and unrelated ignored debt."],
      "forbidden": ["A passing parent, zero-skip aggregate or partial output replacing missing/failed/skipped/inconclusive required leaves."],
      "interactions": ["Safe XML parsing and exact artifact/definition identity."],
      "scenarios": [{ "id": "M01/scenario/terminal", "kind": "boundary", "expectation": "Two required passes coexist with one disclosed ignored leaf; every required nonpass/missing/duplicate fails." }],
      "authority": { "status": "unresolved", "reference": null }
    },
    {
      "id": "M01/identity", "version": "0.1", "lifecycle": "unresolved",
      "preconditions": ["Synthetic expected and observed identity envelopes are supplied."],
      "allowed": ["Exact source/base/merge/tree, evaluator/policy/spec/cohort, dependency/artifact/TFM/runtime/fixture identities."],
      "forbidden": ["Borrowed candidates, package boundaries, artifacts, runtimes or fixtures."],
      "interactions": ["No producer or operating profile is admitted by synthetic consistency."],
      "scenarios": [{ "id": "M01/scenario/identity", "kind": "negative", "expectation": "Each independently varied identity mismatch blocks reconciliation." }],
      "authority": { "status": "unresolved", "reference": null }
    },
    {
      "id": "M01/history", "version": "0.1", "lifecycle": "unresolved",
      "preconditions": ["A native task/attempt disposition is represented in synthetic input."],
      "allowed": ["Complete retained attempts and original failure classification."],
      "forbidden": ["A later pass erasing failed predecessors or native parent/task failure."],
      "interactions": ["Retry admissibility and actual collection remain pending, not a new numerical retry policy."],
      "scenarios": [{ "id": "M01/scenario/history", "kind": "negative", "expectation": "Missing prior attempts and retained failure cannot become a first-pass success." }],
